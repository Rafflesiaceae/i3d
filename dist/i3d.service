[Unit]
Description=i3d
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/i3d --journald
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

# Environment=DEBUG=1
# Environment=I3D_DIR=%h/.config/i3d

[Install]
WantedBy=graphical-session.target
